    search:'Поиск по названию курса или категории слушателей',
    expand:'Открыть все',
    collapse:'Закрыть все',
    home:'Главная',
    headers:['№','Категория слушателей','Название образовательной программы','Академические часы','Стоимость'],
    noResults:'По вашему запросу курсы не найдены'
  }
};

let lang = localStorage.getItem('orleuLanguage') || 'kz';
let allOpen = false;

function esc(value) {
  return String(value || '').replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[s]));
}

function render() {
  const t = i18n[lang];
  const query = document.getElementById('searchInput').value.trim().toLowerCase();

  document.documentElement.lang = lang;
  document.getElementById('pageTitle').textContent = t.title;
  document.getElementById('pageLead').textContent = t.lead;
  document.getElementById('totalLabel').textContent = t.total;
  document.getElementById('searchInput').placeholder = t.search;
  document.getElementById('expandBtn').textContent = allOpen ? t.collapse : t.expand;
  document.getElementById('homeBtn').textContent = t.home;
  document.getElementById('kzBtn').classList.toggle('active', lang === 'kz');
  document.getElementById('ruBtn').classList.toggle('active', lang === 'ru');

  let output = '';
  sectionMeta.forEach((meta, index) => {
    const filtered = rows.filter(r => {
      if (r.section !== meta.key) return false;
      if (!query) return true;
      return (r.audience_full + ' ' + r.program + ' ' + r.hours + ' ' + r.price).toLowerCase().includes(query);
    });

    if (query && filtered.length === 0) return;

    const openClass = (allOpen || index === 0 || query) ? ' open' : '';
    output += `<section class="section${openClass}" data-key="${meta.key}">
      <button class="section-head" type="button">
        <span class="section-icon">${meta.icon}</span>
        <span class="section-title">
          <h2>${esc(lang === 'kz' ? meta.kz : meta.ru)}</h2>
          <p>${filtered.length} / ${rows.filter(r=>r.section===meta.key).length}</p>
        </span>
        <span class="count">${filtered.length}</span>
        <span class="chev">⌄</span>
      </button>
      <div class="section-body">`;

    if (filtered.length) {
      output += `<div class="table-wrap"><table><thead><tr>
        ${t.headers.map(h=>`<th>${esc(h)}</th>`).join('')}
      </tr></thead><tbody>`;
      filtered.forEach(r => {
        output += `<tr>
          <td data-label="${esc(t.headers[0])}">${r.n}</td>
          <td data-label="${esc(t.headers[1])}">${esc(r.audience_full)}</td>
          <td data-label="${esc(t.headers[2])}">${esc(r.program || r.audience)}</td>
          <td data-label="${esc(t.headers[3])}">${esc(r.hours)}</td>
          <td data-label="${esc(t.headers[4])}">${esc(r.price)}</td>
        </tr>`;
      });
      output += `</tbody></table></div>`;
    } else {
      output += `<div class="empty">${esc(t.noResults)}</div>`;
    }
    output += `</div></section>`;
  });

  if (!output) output = `<div class="empty">${esc(t.noResults)}</div>`;
  document.getElementById('sections').innerHTML = output;

  document.querySelectorAll('.section-head').forEach(btn => {
    btn.addEventListener('click', () => btn.closest('.section').classList.toggle('open'));
  });
}

document.getElementById('searchInput').addEventListener('input', render);
document.getElementById('expandBtn').addEventListener('click', () => {
  allOpen = !allOpen;
  render();
});
document.getElementById('kzBtn').addEventListener('click', () => {
  lang='kz'; localStorage.setItem('orleuLanguage','kz'); render();
});
document.getElementById('ruBtn').addEventListener('click', () => {
  lang='ru'; localStorage.setItem('orleuLanguage','ru'); render();
});

render();
</script>
</body>
</html>
