:root {
  --blue:#0d47a1;
  --blue2:#1565c0;
  --gold:#f5a623;
  --bg:#f4f7fb;
  --text:#1d2939;
  --muted:#667085;
  --line:#dce6f2;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--text)}
header{position:sticky;top:0;z-index:1000;background:#fff;box-shadow:0 5px 22px rgba(15,42,75,.08)}
.nav{max-width:1400px;margin:auto;padding:11px 5%;display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:12px;min-width:0;flex:1}
.brand-mark{width:52px;height:52px;border-radius:15px;background:linear-gradient(145deg,var(--blue),var(--blue2));display:grid;place-items:center;color:#fff;font-size:21px;font-weight:800}
.brand-text b{display:block;color:var(--blue);font-size:16px}
.brand-text span{display:block;color:var(--muted);font-size:11px;line-height:1.3}
.nav-actions{display:flex;gap:9px;align-items:center}
.nav-btn{border:0;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer;text-decoration:none}
.nav-btn.home{background:#eef4ff;color:var(--blue)}
.nav-btn.lang{background:var(--blue);color:#fff}
.nav-btn.lang.active{background:var(--gold);color:#19324d}
.hero{padding:60px 5% 34px;background:linear-gradient(135deg,#0d47a1,#1976d2);color:#fff}
.hero-inner{max-width:1400px;margin:auto}
.hero h1{margin:0 0 14px;font-size:clamp(30px,5vw,53px);line-height:1.1}
.hero p{max-width:820px;margin:0;font-size:17px;line-height:1.65;opacity:.92}
.stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.stat{padding:10px 14px;border-radius:999px;background:rgba(255,255,255,.14);backdrop-filter:blur(5px);font-weight:700;font-size:14px}
main{max-width:1400px;margin:auto;padding:28px 5% 80px}
.tools{display:grid;grid-template-columns:1fr auto;gap:14px;margin-bottom:24px}
.search{width:100%;padding:16px 18px;border:1px solid var(--line);border-radius:14px;background:#fff;font-size:16px;outline:none}
.search:focus{border-color:var(--blue2);box-shadow:0 0 0 4px rgba(21,101,192,.1)}
.expand-btn{border:0;border-radius:14px;background:var(--blue);color:#fff;padding:0 20px;font-weight:800;cursor:pointer}
.section{background:#fff;border:1px solid var(--line);border-radius:20px;margin-bottom:18px;overflow:hidden;box-shadow:0 10px 30px rgba(15,42,75,.06)}
.section-head{width:100%;border:0;background:#fff;padding:21px 22px;display:flex;align-items:center;gap:14px;text-align:left;cursor:pointer}
.section-icon{width:48px;height:48px;border-radius:15px;background:#eef4ff;display:grid;place-items:center;font-size:24px;flex:0 0 auto}
.section-title{flex:1}
.section-title h2{margin:0;color:var(--blue);font-size:21px}
.section-title p{margin:5px 0 0;color:var(--muted);font-size:14px}
.count{padding:7px 11px;border-radius:999px;background:#fff3dc;color:#8b5700;font-weight:800;font-size:13px}
.chev{font-size:24px;color:var(--blue);transition:.25s}
.section.open .chev{transform:rotate(180deg)}
.section-body{display:none;padding:0 18px 20px}
.section.open .section-body{display:block}
.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:15px}
table{width:100%;border-collapse:collapse;min-width:900px}
th{background:#0d47a1;color:#fff;padding:13px 12px;text-align:center;font-size:13px}
td{padding:13px 12px;border-bottom:1px solid #e9eef5;vertical-align:top;font-size:14px;line-height:1.5}
tr:last-child td{border-bottom:0}
td:nth-child(1){width:55px;text-align:center;font-weight:800;color:var(--blue)}
td:nth-child(2){width:28%;color:#475467}
td:nth-child(3){width:43%;font-weight:600}
td:nth-child(4),td:nth-child(5){text-align:center;font-weight:800;white-space:nowrap}
.empty{padding:30px;text-align:center;color:var(--muted)}
footer{background:#0d47a1;color:#fff;text-align:center;padding:30px 20px}
@media(max-width:700px){
  .brand-text span{display:none}
  .nav{padding:9px 12px}
  .nav-btn.home{display:none}
  .hero{padding:42px 18px 28px}
  main{padding:18px 12px 60px}
  .tools{grid-template-columns:1fr}
  .expand-btn{min-height:48px}
  .section-head{padding:17px 14px}
  .section-title h2{font-size:17px}
  .section-title p{font-size:12px}
  .count{display:none}
  .section-body{padding:0 10px 12px}
  .table-wrap{border:0;overflow:visible}
  table,thead,tbody,tr,td{display:block;min-width:0;width:100%}
  thead{display:none}
  tr{margin-bottom:12px;border:1px solid var(--line);border-radius:15px;background:#fff;padding:12px;box-shadow:0 7px 18px rgba(15,42,75,.05)}
  td{border:0;padding:7px 0;text-align:left!important;width:auto!important;white-space:normal!important}
  td::before{content:attr(data-label);display:block;color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase;margin-bottom:3px}
  td:first-child{font-size:16px}
}
</style>
</head>
